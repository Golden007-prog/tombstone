# One of these is enough. The agent auto-detects whichever is set.
# Only the LLM needs a key -- embeddings run locally via fastembed at ~5ms/query, zero cost.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional overrides
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5

# FalkorDB. Port 6380, not 6379: a local Homebrew redis-server commonly owns 6379 and
# silently shadows Docker's mapping, which surfaces as "unknown command 'GRAPH.QUERY'".
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
