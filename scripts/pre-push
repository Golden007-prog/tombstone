#!/usr/bin/env bash
# Refuse a push that the checks already know is broken.
#
# Twice in one day I pushed a state whose checker was, at that moment, printing the failure on my
# screen: once a CI step count the README had outgrown, once a demo beat at 3.1 words per second.
# Both times the information existed and I did not read it. Resolve is not a mechanism.
#
# Install once:
#     git config core.hooksPath scripts
#
# It runs the checks that need nothing but this repository, which is what makes it fast enough to
# live in a push. The database-backed ones stay in ./preflight.sh and in CI -- a hook that takes a
# minute is a hook people pass --no-verify to.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# A python that actually has pyyaml. The workflow check used to run under whatever `python3` is
# on PATH and exit 0 on ImportError, "so CI parses it anyway" -- and the system python3 here has
# no pyyaml, so that check printed "ok" on every push for its entire life while parsing nothing.
# A check that cannot run must say so, never pass.
YAML_PY=""
# /usr/bin/python3 is listed explicitly because on macOS it ships WITH pyyaml while the Homebrew
# python3 that usually shadows it on PATH does not -- and a git hook runs with its own PATH, so
# "whatever python3 resolves to" is not a decision worth leaving to chance.
for _c in "${PY:-}" ".venv/bin/python" "$(command -v python3 || true)" "/usr/bin/python3"; do
  [ -n "$_c" ] && [ -x "${_c%% *}" ] || continue
  if "$_c" -c "import yaml" >/dev/null 2>&1; then YAML_PY="$_c"; break; fi
done

fail=0
run() {
  local label="$1"; shift
  if out="$("$@" 2>&1)"; then
    printf '  ok    %s\n' "$label"
  else
    printf '  FAIL  %s\n' "$label"
    printf '%s\n' "$out" | tail -4 | sed 's/^/          /'
    fail=1
  fi
}

echo "pre-push: the checks that need no database"
run "the demo script is speakable"  python3 scripts_check_demo_timing.py
run "the narration cut matches the script" python3 scripts_build_narration.py --check
run "SUBMISSION.md's stated lengths" python3 scripts_check_submission_lengths.py
run "committed artefacts match the code" python3 scripts_check_shots_fresh.py --hashes-only
# The prose counts, pinned to the dict the live run is verified against. This belongs in the
# push gate rather than in CI because the worst copy of this claim lives in the GitHub repo
# description -- the first text a judge reads, and the one string no file-reading check can
# see. `gh` is authenticated here and may not be in CI, so here is where it can actually look.
run "drafted/refused counts match the verified run" python3 scripts_check_action_counts.py
run "that count checker can still fail"             python3 scripts_check_action_counts.py --self-test

# This one is here rather than only in preflight because of WHEN it can be right. It
# computes the upload from `git archive HEAD`, so before a commit HEAD lacks the file you
# just added and the count passes; after the commit it fails. preflight runs pre-commit
# and said ok, CI ran post-commit and went red. Adding any file guaranteed one red commit.
# At the push, HEAD is already what CI will see.
run "FINISH.md matches what the deploy will upload" python3 scripts_check_deploy_size.py
# A token-shaped string must never leave this machine. This matters today specifically: the next
# thing that happens to this repository is somebody exporting HF_TOKEN and running a deploy. The
# deploy script reads it from the environment and never writes it down, and .env is ignored -- but
# the cost of being wrong once is a revoked key and a public credential, and the check is a grep.
# Needs no database, so it belongs here rather than in CI: a sentence that overclaims this
# project's own verification should be stopped before it is pushed, not reported after. Five of
# them shipped before this existed.
run "no universal claims about checking" "${YAML_PY:-python3}" scripts_check_verification_claims.py

run "no credential-shaped strings in what is being pushed" sh -c '
  if git grep -nIE "(hf_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)" -- . >/tmp/pp-secrets 2>/dev/null; then
    echo "credential-shaped strings found in tracked files:"; cat /tmp/pp-secrets; exit 1
  fi
  exit 0'

if [ -n "$YAML_PY" ]; then
  # EVERY workflow, not just verify.yml. This checked one file and I broke a different one --
  # keepwarm.yml, with a heredoc whose body sat at column 0 and silently ended the YAML block
  # scalar. A scheduled workflow fails on its own schedule, so that would have surfaced as a red
  # cross on the repository hours later, with nothing connecting it to the push that caused it.
  run "every workflow still parses"   "$YAML_PY" -c "
import pathlib, sys, yaml
bad = []
for f in sorted(pathlib.Path('.github/workflows').glob('*.yml')):
    try:
        yaml.safe_load(f.read_text())
    except Exception as e:
        bad.append(f'{f}: {str(e).splitlines()[0]}')
if bad:
    sys.exit(chr(10).join(bad))"
else
  printf '  SKIP  the workflows were NOT parsed: no python here has pyyaml\n'
  printf '        (pip install pyyaml, or set PY to an interpreter that has it)\n'
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

  Push refused. Fix the above, or --no-verify if you mean it.
  The database-backed checks are ./preflight.sh and they have not run here.
MSG
  exit 1
fi
echo "  (run ./preflight.sh for the database-backed checks)"
